# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cleverhub_sat?schema=public"

# Authentication
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
SESSION_SECRET=another-long-random-secret

# CORS
CLIENT_URL=http://localhost:5173

# Desmos (optional - requires authorised API key / agreement)
DESMOS_API_KEY=

# Adaptive routing thresholds (configurable approximations)
RW_MODULE2_HIGH_THRESHOLD=0.60
MATH_MODULE2_HIGH_THRESHOLD=0.60

# Scoring (documented approximations)
SCORE_SCALE_RW_BASE=200
SCORE_SCALE_MATH_BASE=200
